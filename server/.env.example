# ============================================================
#  NOVA STORE — BACKEND ENVIRONMENT VARIABLES
#  Copy this file to `.env` (server/.env) and fill the values.
#  On Render: Dashboard > Service > Environment > add each key.
# ============================================================

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/novastore?retryWrites=true&w=majority

# Port (Render sets this automatically, keep 5000 for local)
PORT=5000

# Secret used to sign login tokens — change to a long random string
JWT_SECRET=change_this_to_a_long_random_string_1234567890

# Admin panel master credentials (login on the same login form)
ADMIN_ID=admin
ADMIN_PASSWORD=123456

# Store settings
CURRENCY=INR
SHIPPING_FEE=49
FREE_SHIPPING_OVER=999

# Frontend origins allowed to call the API (comma separated, * = all)
CORS_ORIGIN=*
