# NOVA Store API - environment
# Copy to .env and fill in real values.

# Required
MONGODB_URI=
JWT_SECRET=change_me_secret

# Admin credentials (used on /admin.html login)
ADMIN_ID=admin
ADMIN_PASSWORD=change_me

# Comma-separated allowed origins, or * for any
CORS_ORIGIN=*

# Store settings
CURRENCY=INR
SHIPPING_FEE=49
FREE_SHIPPING_OVER=999

# Payment-screenshot uploads (defaults to server/uploads)
UPLOADS_DIR=

# Optional: Gemini for the admin "Data Play" assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
