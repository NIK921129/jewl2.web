# ============================================================
#  NOVA STORE — FRONTEND (Vercel) ENVIRONMENT
#  The static frontend reads its API url from public/assets/js/config.js
#  Set the same value here for reference / build pipelines.
# ============================================================

# Your Render backend base url (no trailing slash)
API_BASE_URL=https://your-service.onrender.com

# Admin credentials (must match the backend .env)
ADMIN_ID=admin
ADMIN_PASSWORD=123456
