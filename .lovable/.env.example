# ---------------------------------------------------------
# NOVA API — environment variables (copy to server/.env)
# On Render, add these under: Service → Environment
# ---------------------------------------------------------

# MongoDB Atlas connection string (include the database name)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/nova?retryWrites=true&w=majority

# Long random string used to sign login tokens (never share it)
JWT_SECRET=replace_with_a_long_random_secret

# Admin control-center credentials (used at /admin)
ADMIN_ID=admin
ADMIN_PASSWORD=change_this_password

# Comma separated list of allowed frontend origins ("*" allows all)
CORS_ORIGIN=https://your-store.vercel.app,http://localhost:3000

# Server port (Render sets this automatically)
PORT=5000

# Store defaults
CURRENCY=INR
SHIPPING_FEE=49
FREE_SHIPPING_OVER=999

# Optional: AI helper for the admin "Data Play" screen
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
